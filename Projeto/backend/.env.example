APP_NAME=Fluxo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---------------------------------------------------------------- log
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------- banco (SOMENTE PostgreSQL — RNF36)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fluxodb
DB_USERNAME=fluxouser
DB_PASSWORD=fluxopass
DB_SSLMODE=prefer

# Banco usado pelos testes automatizados (criado separado do de trabalho)
DB_TEST_DATABASE=fluxo_test

# ---------------------------------------------------------------- sessão/fila/cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# ---------------------------------------------------------------- segurança (RF02/RF17/RNF10)
# Token expira em minutos (Sanctum). 0 = nunca expira (não recomendado).
SANCTUM_EXPIRATION=60
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- regras do Fluxo (centavos)
FLUXO_KYC_AUTOMATICO=true
FLUXO_2FA_PADRAO=false
FLUXO_2FA_VALIDADE=3
FLUXO_2FA_TENTATIVAS=3
FLUXO_LOGIN_TENTATIVAS=5
FLUXO_LOGIN_BLOQUEIO=15

FLUXO_LIMITE_TRANSACAO=500000
FLUXO_LIMITE_DIARIO=1000000
FLUXO_QTD_DIARIA=20
FLUXO_LIMITE_NOTURNO=100000
FLUXO_LIMITE_NOTURNO_DIARIO=200000
FLUXO_QTD_NOTURNA=5
FLUXO_LIMITE_SEM_CHAVE=50000
FLUXO_LIMITE_SEM_CHAVE_DIARIO=100000
FLUXO_INICIO_NOTURNO=20:00
FLUXO_FIM_NOTURNO=06:00

FLUXO_PIX_NOME="FLUXO BANCO DIGITAL"
FLUXO_PIX_CIDADE="SAO PAULO"

FLUXO_CARTAO_LIMITE=200000
FLUXO_CARTAO_VALIDADE=5
FLUXO_CARTAO_VIRTUAL_DIAS=30

FLUXO_TESOURARIA_EMAIL=tesouraria@fluxo.internal
FLUXO_TESOURARIA_CONTA=0000-000001
