digraph G { graph [rankdir=LR,bgcolor="white",pad=.3,nodesep=.4,ranksep=.75,fontname="DejaVu Sans",label="CLS-08  |  Depósito e Pix simulados (implementação)",labelloc=t,fontsize=18]; node [shape=record,fontname="DejaVu Sans",fontsize=10,style="rounded,filled",fillcolor="#f5f8fc",color="#536579"]; edge [color="#536579",fontname="DejaVu Sans",fontsize=9]; guard [label="{SimulacaoFinanceira|+handle(request,next)}",fillcolor="#fff2da"]; dep [label="{DepositoSimuladoController|+__invoke(request,...)}"]; pix [label="{PixController|+receber(request)}"]; pay [label="{PagamentosService|+depositar(...)|+receberPix(...)}",fillcolor="#e9f6f1"]; led [label="{LancamentoService|+creditar(...)}",fillcolor="#e9f6f1"]; conta [label="Conta"]; trans [label="Transacao"]; lan [label="Lancamento"]; aud [label="AuditoriaService"]; guard -> dep [label="autoriza depósito"]; guard -> pix [label="autoriza Pix simulado"]; dep -> pay; pix -> pay; dep -> aud [style=dashed]; pay -> aud [style=dashed]; pay -> led; led -> conta; led -> trans; trans -> lan [label="1 para 2..*"]; conta -> lan [style=dashed,label="1 para 0..*"]; }